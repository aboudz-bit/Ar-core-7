# ============================================================
# AR-Core-7 Environment Configuration
# ============================================================

# --- Core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arcore7?schema=public"
JWT_SECRET="change-me-to-a-random-64-char-secret"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
PUBLIC_BASE_URL="https://your-domain.com"

# --- Local File Storage (default) ---
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_SIZE_MB=50

# --- Cloud Storage (S3 / Cloudflare R2 / MinIO) ---
# Set STORAGE_PROVIDER to "s3", "r2", or "minio" to enable cloud storage
STORAGE_PROVIDER="local"
STORAGE_BUCKET="arcore7-assets"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- CDN ---
# If using CloudFront, Cloudflare, or another CDN in front of storage
CDN_BASE_URL=""

# --- Signed URLs ---
SIGNED_URL_TTL=3600

# --- Redis (for production rate limiting) ---
# Supports Upstash REST API or native Redis via ioredis
# If not set, falls back to in-memory rate limiting
REDIS_URL=""

# --- Webhooks ---
WEBHOOK_SIGNING_SECRET="whsec_change-me-to-a-random-secret"

# --- Analytics ---
ANALYTICS_ENABLED=true

# --- Image-to-3D Generation Pipeline ---
# Enable automatic image-to-3D model generation
IMAGE_TO_3D_ENABLED=false
# Provider: "triposr" (faster, lighter) or "instantmesh" (higher quality)
IMAGE_TO_3D_PROVIDER="triposr"
# TripoSR API endpoint (run TripoSR server locally or point to remote)
TRIPOSR_ENDPOINT="http://localhost:8080"
# InstantMesh API endpoint (optional, for high-quality generation)
INSTANTMESH_ENDPOINT="http://localhost:8081"
# Maximum image size for 3D generation (MB)
MAX_IMAGE_SIZE_MB=10
# Timeout for 3D generation requests (ms)
IMAGE_TO_3D_TIMEOUT_MS=120000
# Auto-publish AR experience when 3D model is generated
IMAGE_TO_3D_AUTO_PUBLISH=true
